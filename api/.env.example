# ===== LLM（千问 Qwen / 阿里云百炼，OpenAI 兼容）=====
# 必填：从阿里云百炼控制台获取的 API Key。字段名为兼容已有本地配置保留。
QWEN_API_KEY=your_qwen_api_key_here

# 默认使用 Flash；关键分析由系统自动路由至 Plus。
QWEN_MODEL=qwen3.6-flash
# 阿里云百炼 OpenAI 兼容网关地址（按实际地域/接入点配置）
QWEN_BASE_URL=https://your-qwen-compatible-endpoint/v1

# ===== 搜索 API（采集 Agent 用）=====
# 博查 Bocha Web Search（必填，从 https://open.bocha.cn 获取，形如 sk-xxxxxx）
BOCHA_API_KEY=sk-xxxxxx
# 博查接口网关（一般无需改）
BOCHA_BASE_URL=https://api.bocha.cn/v1

# ===== 自媒体平台采集器 cookie/token（可选）=====
DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3400
ENABLE_DEMO_FALLBACK=true
